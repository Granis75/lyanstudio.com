{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/alcaisse.html",
      "destination": "/alcaisse-evidence.html",
      "permanent": true
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
